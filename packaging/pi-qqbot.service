[Unit]
Description=pi-qqbot — QQ 官方机器人接入 Pi 会话
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 路径按需修改；--cwd 是 pi 的工作目录（QQ 里让 agent 干活的位置）
# 源码安装用这个路径；npm 全局安装可改成 ExecStart=%h/.npm-global/bin/pi-qqbot --cwd %h
ExecStart=%h/Agent/Core/系统/智能设定/Pi插件/pi-qqbot/bin/pi-qqbot.mjs --cwd %h
WorkingDirectory=%h
Restart=always
RestartSec=5
Environment=NO_COLOR=1

[Install]
WantedBy=default.target
